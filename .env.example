# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000

MONGO_URI=
ADMIN_SESSION_TTL_HOURS=8

ADMIN_TOKEN_SECRET=
 
# Exact frontend origins, comma-separated. No wildcard, path, or trailing slash.
CORS_ORIGINS=http://localhost:3001,https://remote-agric-cooperative.vercel.app
REMOTE_AGRIC_API_URL=https://api.remoteagricng.com

# OAuth Web application credentials; keep the secret on this backend only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# JSON only. Compressed request bodies and form bodies are not accepted.
HTTP_BODY_LIMIT_KB=64

# Per client IP, per route, in this process. TTL is in milliseconds.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
# Additional requests allowed per IP/route in a one-second window.
RATE_LIMIT_BURST_MAX=10

APP_ORIGIN=http://localhost:3001

COOKIE_SAME_SITE=lax

PAYSTACK_SECRET_KEY=
PAYSTACK_TRANSFERS_ENABLED=false

LOAN_FLAT_FEE_BPS=
LOAN_MAX_MONTHS=12
LOAN_TERMS_VERSION=
