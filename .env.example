# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000

# Cooperative admins only: use this project's database, not Remote Agric's.
# Admin login returns 503 until configured. Create accounts with pnpm admin:create.
ADMIN_MONGO_URI=mongodb://127.0.0.1:27017
ADMIN_MONGO_DB=remote_cooperative
ADMIN_SESSION_TTL_HOURS=8

# Exact frontend origins, comma-separated. No wildcard, path, or trailing slash.
# Production requires an explicit list containing only HTTPS origins.
CORS_ORIGINS=http://localhost:3001,https://remote-agric-cooperative.vercel.app
REMOTE_AGRIC_API_URL=https://api.remoteagricng.com
# An origin already allowed by Remote Agric's FRONTEND_URL/FRONTEND_LOCALHOST.
# Used only for server-to-server requests, including logout.
REMOTE_AGRIC_ORIGIN=https://remoteagricng.com

# OAuth Web application credentials; keep the secret on this backend only.
# Configure all three together. Register this exact callback in Google Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Local callback: http://localhost:3001/api/auth/google/callback
# Production callback: https://remote-agric-cooperative.vercel.app/api/auth/google/callback
# Set the same client ID as GOOGLE_COOPERATIVE_CLIENT_ID in remote-backend.

# JSON only. Compressed request bodies and form bodies are not accepted.
HTTP_BODY_LIMIT_KB=64

# Per client IP, per route, in this process. TTL is in milliseconds.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
# Additional requests allowed per IP/route in a one-second window.
RATE_LIMIT_BURST_MAX=10

# Identity and email delivery are owned by the Remote Agric API. Deploy its
# /api/auth/google/token endpoint for Google login. No duplicate password DB.
