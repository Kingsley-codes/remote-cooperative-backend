# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# Exact frontend origins, comma-separated. No wildcard, path, or trailing slash.
# Production requires an explicit list containing only HTTPS origins.
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# JSON only. Compressed request bodies and form bodies are not accepted.
HTTP_BODY_LIMIT_KB=64

# Per client IP, per route, in this process. TTL is in milliseconds.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
# Additional requests allowed per IP/route in a one-second window.
RATE_LIMIT_BURST_MAX=10

# Identity, database, and payment secrets will be added with their integrations.
# No tokens are accepted on protected routes until Remote Agric verification exists.
